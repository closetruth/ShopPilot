# DeepSeek 走 OpenAI 兼容接口
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat

# 每轮发给模型的历史消息条数上限

# MySQL（与 docker-compose.yml 对应）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=shoppilot
MYSQL_PASSWORD=shoppilot
MYSQL_DATABASE=shoppilot
MYSQL_ROOT_PASSWORD=rootpass

# MCP 外部工具（stdio 子进程）
# MCP_ENABLED=1 开启；配置路径默认仓库根 mcp_servers.json
MCP_ENABLED=1
MCP_CONFIG=