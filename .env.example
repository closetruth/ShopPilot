# DeepSeek 走 OpenAI 兼容接口
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat

# 每轮发给模型的历史消息条数上限

# MySQL（与 docker-compose.yml 对应）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=shoppilot
MYSQL_PASSWORD=shoppilot
MYSQL_DATABASE=shoppilot
MYSQL_ROOT_PASSWORD=rootpass

# MCP 外部工具（stdio 子进程）
# MCP_ENABLED=1 开启；配置路径默认仓库根 mcp_servers.json
MCP_ENABLED=1
MCP_CONFIG=

# 成本控制：三层软闸，配 0 或留空即关闭该层
# 单轮上限走 app.chat.agent 的 TURN_TOKEN_LIMIT，默认 8000
CONVERSATION_DAILY_TOKEN_BUDGET=0
GLOBAL_DAILY_COST_YUAN=0

# 价目（元 / 百万 token）。不填则成本恒为 0，看板只显示 token
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0

# Langfuse 追踪（可选）。三项缺一即静默降级为不追踪
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# 精排（可选）。默认关：精排分与向量分是两个量纲，阈值没在真实分布上
# 标定过就打开，等于用一把没刻度的尺去拦回答。
# 自建微调服务填 http://192.168.6.23:8010 即可，不带 /v1 也能用
RERANK_ENABLED=0
RERANK_BASE_URL=
RERANK_MODEL=
# 精排分阈值。留空表示「闸仍用向量分，精排只管排序」，标定后再填
RERANK_MIN_SCORE=
# 开精排时的向量召回条数。太小则精排救不回排在第 8 位的正确条款
RERANK_RECALL_K=10