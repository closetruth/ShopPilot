# 训练容器环境变量模板。复制为 deploy/trainer.env 后按需改。
# 真实值不进仓库，这里只放占位符。

# 训练服务监听端口（compose 映射到宿主机同名端口）
TRAINER_PORT=8010

# 调用训练接口的共享令牌。留空表示不校验，仅限内网临时使用
TRAINER_TOKEN=change-me

# 基座模型。哈工大讯飞中文 RoBERTa 全参微调
BASE_MODEL=hfl/chinese-roberta-wwm-ext

# HuggingFace 镜像。远端在内网，直连 huggingface.co 大概率超时
HF_ENDPOINT=https://hf-mirror.com

# 输入截断长度。query + doc 拼接后超过就截断，256 覆盖绝大多数条款
MAX_LENGTH=256

# 训练超参。BATCH_SIZE 留空由程序按有无 GPU 自适应（GPU 16 / CPU 8）
EPOCHS=4
LR=2e-5
BATCH_SIZE=
SEED=20261104

# 容器资源上限，避免训练吃满远端机器影响 MySQL 与 Milvus
TRAINER_CPUS=6
TRAINER_MEMORY=12g

# 数据集在容器内直接读远端 MySQL 构建。标注、FAQ、轨迹本来就在这台机器，
# 不必先拉到本地再传回来。容器和 MySQL 跑在同一台机器，所以默认 127.0.0.1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=shoppilot
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=shoppilot