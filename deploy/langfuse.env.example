# Langfuse 自托管环境变量模板
#
# 复制成 langfuse.env 后替换全部 CHANGEME；langfuse.env 禁止提交到仓库。
# 密钥生成：openssl rand -hex 32

# --- Postgres（Langfuse 业务库） ---
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=langfuse
DATABASE_URL=postgresql://langfuse:CHANGEME@postgres:5432/langfuse

# --- 加密与认证 ---
SALT=CHANGEME
ENCRYPTION_KEY=CHANGEME
NEXTAUTH_SECRET=CHANGEME
NEXTAUTH_URL=http://127.0.0.1:3005

# --- ClickHouse（trace 存储） ---
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGEME
CLICKHOUSE_DB=default
CLICKHOUSE_URL=http://clickhouse:8123

# --- Redis（队列与缓存） ---
REDIS_CONNECTION_STRING=redis://redis:6379

# --- MinIO（事件上传） ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGEME
MINIO_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=us-east-1

# --- ShopPilot 侧（写进应用自己的 .env，不是 compose 用） ---
# 在 Langfuse UI 里创建项目后拿到的 key
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_HOST=http://<langfuse主机>:3005